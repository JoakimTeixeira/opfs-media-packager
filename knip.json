{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/background.ts",
    "src/playlist.ts",
    "src/page-playlist-probe.ts",
    "src/popup.ts",
    "scripts/*.ts",
    "tests/**/*.ts",
    "lib/**/*.test.ts",
    "src/**/*.test.ts"
  ],
  "project": [
    "*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/**/*.ts"
  ],
  "ignoreDependencies": ["@stryker-mutator/api"]
}
