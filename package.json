{
  "$schema": "https://json.schemastore.org/package",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:extension && node scripts/check-extension-files.ts",
    "build:extension": "esbuild src/app.ts src/background.ts src/track.ts src/popup.ts --bundle --format=esm --target=chrome120 --sourcemap --tree-shaking=true --outdir=dist && esbuild src/content.ts src/page-track-probe.ts --bundle --format=iife --target=chrome120 --sourcemap --tree-shaking=true --outdir=dist",
    "test": "vitest run",
    "test:unit": "vitest run lib src",
    "test:integration": "vitest run tests/integration",
    "check:architecture": "vitest run tests/architecture",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "setup:e2e": "playwright install chromium",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test:contract": "vitest run tests/contract",
    "coverage": "vitest run --coverage",
    "coverage:check": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --project tsconfig.json",
    "lint:html": "htmlhint \"src/*.html\"",
    "lint": "npm run lint:js && npm run lint:html",
    "check:duplication": "jscpd .",
    "check:dead-code": "knip",
    "check:quality": "npm run check:duplication && npm run check:dead-code",
    "harness:score": "harness-score",
    "verify": "npm run build && npm run format:check && npm run lint && npm run check:quality && npm run typecheck && npm test && npm run coverage:check && npm run test:e2e",
    "test:watch": "vitest"
  },
  "overrides": {
    "minimatch@^10": "11.0.1",
    "glob@^13": "14.0.3",
    "qs": "6.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^21.0.4",
    "harness-score": "^1.12.0",
    "htmlhint": "^1.9.2",
    "jscpd": "^5.4.3",
    "knip": "^5.88.1",
    "lucide": "^1.73.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.1.1"
  }
}
