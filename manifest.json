{
  "manifest_version": 3,
  "name": "OPFS Media Packager v2.49",
  "version": "2.49.0",
  "description": "Saves unencrypted HLS streams to a configured Chrome Downloads subfolder.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "scripting",
    "webRequest",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "OPFS Media Packager v2.49",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/courses/*", "https://*/c/*/sections/*/lessons/*"],
      "js": ["dist/page-playlist-probe.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "120"
}
